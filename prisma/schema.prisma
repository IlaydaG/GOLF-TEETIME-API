generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model SunData {
  id                 Int      @id(map: "PK__SunData__3213E83F50F56D11") @default(autoincrement())
  date               DateTime @unique(map: "UQ__SunData__D9DE21FDEF95C5E4") @db.Date
  sunrise            DateTime @db.DateTimeOffset
  sunset             DateTime @db.DateTimeOffset
  civilTwilightBegin DateTime @db.DateTimeOffset
  civilTwilightEnd   DateTime @db.DateTimeOffset
}

model weather_forecast {
  id                        Int      @id(map: "PK__weather___3213E83F55C0790D") @default(autoincrement())
  date                      DateTime @unique(map: "UQ__weather___D9DE21FD6DDDD18C") @db.Date
  weathercode               Int
  weather_description       String   @db.NVarChar(50)
  severity                  String   @db.NVarChar(10)
  temp_max                  Float
  temp_min                  Float
  precipitation_probability Int
  precipitation_sum         Float
  humidity                  Float    @default(0, map: "DF__weather_f__humid__3B75D760")
  wind_speed                Float    @default(0, map: "DF__weather_f__wind___3C69FB99")
}

model TEETIME_TABLE {
  TEETIMEDATE   DateTime  @id(map: "PK__TEETIME___4CB317327BEC601C") @db.Date
  FIRSTTEETIME  DateTime? @db.Time
  LASTTEETIME   DateTime? @db.Time
  TWILIGHTSTART DateTime? @db.Time
  TOTALTEETIME  Int?
}
